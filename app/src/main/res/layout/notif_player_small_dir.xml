<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/n_cont"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">
        <TextView android:id="@+id/n_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/n_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        <ProgressBar android:id="@+id/n_prog" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="#FFF2A154" android:progressBackgroundTint="#44FFFFFF" />
    </LinearLayout>
    <ImageButton android:id="@+id/n_prev" android:layout_width="36dp" android:layout_height="40dp" android:background="@null" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="prev" android:src="@drawable/ic_n_prev" />
    <ImageButton android:id="@+id/n_play" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:padding="4dp" android:scaleType="fitCenter" android:contentDescription="play" android:src="@drawable/ic_n_play" />
    <ImageButton android:id="@+id/n_next" android:layout_width="36dp" android:layout_height="40dp" android:background="@null" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="next" android:src="@drawable/ic_n_next" />
    <ImageView android:id="@+id/n_capa" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:src="@drawable/ic_notification" />
</LinearLayout>
